{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learn-git-question",
  "title": "Question",
  "description": "A Learn-Git Question Schema",
  "type": "array",
  "items": {
    "properties": {
      "exercise_title": {
        "type": "string",
        "description": "The question title"
      },
      "exercise_description": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "A detailed description of the exercise. Each line is a paragraph."
      },
      "command_history": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "script": {
        "type": "string"
      },
      "hints": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "expected": {
        "type": "string"
      }
    }
  }
}
