{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learn-git-question",
  "title": "Question",
  "description": "A Learn-Git Question Schema",
  "type": "array",
  "items": {
    "properties": {
      "exercise_title": {
        "type": "string",
        "description": "The question title"
      },
      "exercise_description": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "A detailed description of the exercise. Each line is a paragraph."
      },
      "screenshots": {
        "type": "array",
        "description": "A list of relative URLs with screenshots to include in the exercise description. Screenshots are loaded from nextjs' public folder.",
        "items": {
          "type": "string"
        }
      },
      "command_history": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "script": {
        "type": "string"
      },
      "hints": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "User friendly name of the evaluation"
            },
            "explanation": {
              "type": "array",
              "description": "A detailed explanation of the evaluation.",
              "items": {
                "type": "string"
              }
            },
            "command": {
              "description": "The shell command to run for the evaluation. The return code should be 0",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
